        </mxCell>
        <mxCell id="f-cardview" value="&lt;b&gt;CardView&lt;/b&gt;&lt;br&gt;&lt;i&gt;单张手牌 UI&lt;/i&gt;&lt;br&gt;&lt;br&gt;Text refs&lt;br&gt;Button&lt;br&gt;card&lt;br&gt;onClicked: Action&amp;lt;Card&amp;gt;&lt;br&gt;&lt;br&gt;SetCard()&lt;br&gt;HandleClick()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1530" y="190" width="210" height="190" as="geometry" />
        </mxCell>
        <mxCell id="f-boardview" value="&lt;b&gt;BoardView&lt;/b&gt;&lt;br&gt;&lt;i&gt;单方战场 UI&lt;/i&gt;&lt;br&gt;&lt;br&gt;minionContainer&lt;br&gt;minionViewPrefab&lt;br&gt;minionViews&lt;br&gt;&lt;br&gt;Refresh()&lt;br&gt;Clear()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1300" y="740" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="f-minionview" value="&lt;b&gt;MinionView&lt;/b&gt;&lt;br&gt;&lt;i&gt;单个随从 UI&lt;/i&gt;&lt;br&gt;&lt;br&gt;Text refs&lt;br&gt;Button&lt;br&gt;minion&lt;br&gt;onClicked: Action&amp;lt;Minion&amp;gt;&lt;br&gt;&lt;br&gt;SetMinion()&lt;br&gt;HandleClick()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1530" y="730" width="210" height="200" as="geometry" />
        </mxCell>
        <mxCell id="f-note" value="&lt;b&gt;推荐读图路线&lt;/b&gt;&lt;br&gt;1. 左上 CardData -> Card，看模板和实例。&lt;br&gt;2. 左中 Player / Hero，看玩家资源。&lt;br&gt;3. 左下 Minion / Board，看战场。&lt;br&gt;4. 中间 GameManager 负责规则调度。&lt;br&gt;5. 右侧 UI 只显示和转发点击。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="970" y="130" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="f-legend" value="&lt;b&gt;线条含义&lt;/b&gt;&lt;br&gt;红色：规则调度&lt;br&gt;绿色：玩家拥有资源&lt;br&gt;黄色：战场 / 随从关系&lt;br&gt;紫色：UI 生成子 View&lt;br&gt;橙色虚线：点击回调&lt;br&gt;蓝色：模板数据引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="970" y="720" width="270" height="190" as="geometry" />
        </mxCell>

