  <diagram id="full-overview" name="04 完整版总览">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="full-title" value="&lt;b&gt;阶段 1 完整版总览&lt;/b&gt;&lt;br&gt;左侧是 Core 规则状态，右侧是 UI 显示与输入；中间只保留两个核心入口，减少交叉线" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="20" width="940" height="60" as="geometry" />
        </mxCell>
        <mxCell id="full-core-band" value="Core 规则层：保存和改变游戏状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666666;fontStyle=1;fontSize=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="850" height="930" as="geometry" />
        </mxCell>
        <mxCell id="full-ui-band" value="UI 表现层：显示状态，把点击转成方法调用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="100" width="820" height="930" as="geometry" />
        </mxCell>

        <mxCell id="f-carddata" value="&lt;b&gt;CardData&lt;/b&gt;&lt;br&gt;&lt;i&gt;卡牌模板 .asset&lt;/i&gt;&lt;br&gt;&lt;br&gt;CardName&lt;br&gt;Cost / Attack / Health&lt;br&gt;Description&lt;br&gt;&lt;br&gt;静态配置，不存对局变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="190" width="230" height="170" as="geometry" />
        </mxCell>
        <mxCell id="f-card" value="&lt;b&gt;Card&lt;/b&gt;&lt;br&gt;&lt;i&gt;手牌 / 牌库里的运行时卡牌&lt;/i&gt;&lt;br&gt;&lt;br&gt;CardData&lt;br&gt;CurrentCost&lt;br&gt;&lt;br&gt;ResetCost()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="230" height="150" as="geometry" />
        </mxCell>
        <mxCell id="f-hero" value="&lt;b&gt;Hero&lt;/b&gt;&lt;br&gt;&lt;i&gt;英雄生命主体&lt;/i&gt;&lt;br&gt;&lt;br&gt;Name&lt;br&gt;MaxHealth&lt;br&gt;CurrentHealth&lt;br&gt;IsDead&lt;br&gt;&lt;br&gt;TakeDamage() / Heal()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="470" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="f-player" value="&lt;b&gt;Player&lt;/b&gt;&lt;br&gt;&lt;i&gt;玩家资源&lt;/i&gt;&lt;br&gt;&lt;br&gt;Hero&lt;br&gt;Hand / Deck&lt;br&gt;MaxMana / CurrentMana&lt;br&gt;&lt;br&gt;StartTurn()&lt;br&gt;DrawCard()&lt;br&gt;PlayCard()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f-minion" value="&lt;b&gt;Minion&lt;/b&gt;&lt;br&gt;&lt;i&gt;场上随从实例&lt;/i&gt;&lt;br&gt;&lt;br&gt;CardData&lt;br&gt;Owner: Player&lt;br&gt;Attack / CurrentHealth&lt;br&gt;CanAttack / IsDead&lt;br&gt;&lt;br&gt;TakeDamage()&lt;br&gt;SetCanAttack()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="760" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="f-board" value="&lt;b&gt;Board&lt;/b&gt;&lt;br&gt;&lt;i&gt;双方战场随从列表&lt;/i&gt;&lt;br&gt;&lt;br&gt;playerMinions&lt;br&gt;enemyMinions&lt;br&gt;MaxMinionsPerSide&lt;br&gt;&lt;br&gt;CanSummon()&lt;br&gt;SummonMinion()&lt;br&gt;RemoveMinion()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="750" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f-gm" value="&lt;b&gt;GameManager&lt;/b&gt;&lt;br&gt;&lt;i&gt;Core 对局总控&lt;/i&gt;&lt;br&gt;&lt;br&gt;Player / Enemy / Board&lt;br&gt;CurrentPlayer&lt;br&gt;Winner / IsGameOver&lt;br&gt;&lt;br&gt;StartNewGame()&lt;br&gt;StartTurn() / EndTurn()&lt;br&gt;TryPlayMinionCard()&lt;br&gt;TryAttackMinion()&lt;br&gt;TryAttackHero()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="660" y="390" width="250" height="280" as="geometry" />
        </mxCell>

        <mxCell id="f-gui" value="&lt;b&gt;GameUIController&lt;/b&gt;&lt;br&gt;&lt;i&gt;UI 层总入口&lt;/i&gt;&lt;br&gt;&lt;br&gt;gameManager&lt;br&gt;handView&lt;br&gt;playerBoardView / enemyBoardView&lt;br&gt;Text / Button refs&lt;br&gt;selectedAttacker&lt;br&gt;&lt;br&gt;RefreshAll()&lt;br&gt;HandleCardClicked()&lt;br&gt;HandleMinionClicked()&lt;br&gt;HandleEndTurnClicked()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="970" y="390" width="270" height="280" as="geometry" />
        </mxCell>
        <mxCell id="f-handview" value="&lt;b&gt;HandView&lt;/b&gt;&lt;br&gt;&lt;i&gt;手牌区域 UI&lt;/i&gt;&lt;br&gt;&lt;br&gt;cardContainer&lt;br&gt;cardViewPrefab&lt;br&gt;cardViews&lt;br&gt;&lt;br&gt;SetHand()&lt;br&gt;Refresh()&lt;br&gt;Clear()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
